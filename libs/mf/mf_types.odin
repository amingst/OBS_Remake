// MFVideoInterlaceMode enum — only the value you need right now
MFVideoInterlace_Progressive :: 2

// MFStartup dwFlags
MFSTARTUP_FULL :: 0

// MF_VERSION = (MF_SDK_VERSION << 16) | MF_API_VERSION — same "assembled constant"
// pattern as FRAME_SIZE/FRAME_RATE below, just done once at compile time in C.
MF_SDK_VERSION :: 0x0002
MF_API_VERSION :: 0x0070
MF_VERSION :: (MF_SDK_VERSION << 16) | MF_API_VERSION