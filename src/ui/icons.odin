package ui

// Font Awesome Free Solid codepoints, merged into the Inter fonts (see theme.odin).
// Look up more in the release's metadata/icons.json; only Private Use Area
// codepoints (U+E000-U+F8FF) are merged. FA maps "plus" to ASCII '+', so use Inter's.
ICON_GEAR              :: ""
ICON_CIRCLE_QUESTION   :: ""
ICON_MINUS             :: ""
ICON_FILTER            :: ""
ICON_SLIDERS           :: ""
ICON_ELLIPSIS_VERTICAL :: ""
ICON_XMARK             :: ""
ICON_CHECK             :: ""
ICON_CHEVRON_DOWN      :: ""
ICON_CHEVRON_RIGHT     :: ""
ICON_TRASH             :: ""
ICON_PEN               :: ""
ICON_EXPAND            :: ""
ICON_COMPRESS          :: ""

// Output
ICON_TOWER_BROADCAST :: ""
ICON_RECORD          :: "" // circle
ICON_STOP            :: ""
ICON_SIGNAL          :: ""
ICON_MICROCHIP       :: ""

// Scenes and sources
ICON_LAYER_GROUP  :: ""
ICON_CLAPPERBOARD :: ""
ICON_DISPLAY      :: ""
ICON_WINDOW      :: ""
ICON_GAMEPAD     :: ""
ICON_VIDEO       :: ""
ICON_CAMERA      :: ""
ICON_IMAGE       :: ""
ICON_PALETTE     :: ""
ICON_EYE         :: ""
ICON_EYE_SLASH   :: ""
ICON_LOCK        :: ""
ICON_LOCK_OPEN   :: ""

// Audio
ICON_MICROPHONE       :: ""
ICON_MICROPHONE_SLASH :: ""
ICON_VOLUME_HIGH      :: ""
ICON_VOLUME_XMARK     :: ""
ICON_HEADPHONES       :: ""
